{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.ts": { "maxDuration": 60, "includeFiles": "node_modules/pdfjs-dist/legacy/build/**" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/auth/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/sync", "schedule": "15 10 * * *" },
    { "path": "/api/cron/pool", "schedule": "15 1 * * *" },
    { "path": "/api/cron/nest", "schedule": "*/5 * * * *" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://api.open-meteo.com https://archive-api.open-meteo.com https://api.weather.gov; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
    ] },
    { "source": "/.well-known/(.*)", "headers": [{ "key": "Content-Type", "value": "application/x-pem-file" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-store" }, { "key": "Vary", "value": "Cookie" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }, { "key": "Vary", "value": "Cookie" }] }
  ]
}
